@model AerolineaVIP_MVC.Models.Vuelo

@{
    ViewBag.Title = "Crear Vuelo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 600px; margin: 40px auto; padding: 0 20px;">

    <!-- Encabezado y botón de retorno -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <div>
            <h2 style="font-weight: 800; color: var(--vip-ink); font-size: 26px; margin-bottom: 5px;">Programar Nuevo Vuelo</h2>
            <p style="color: var(--vip-mute); font-size: 14px; margin: 0;">Asigne frecuencia, fecha de operación, aeronave y estado del vuelo.</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" style="background: var(--vip-bg2); color: var(--vip-ink); padding: 8px 18px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 13px;">← Volver</a>
        </div>
    </div>

    <!-- Tarjeta contenedora del formulario -->
    <div style="background: var(--vip-card); border-radius: 16px; box-shadow: 0 4px 25px rgba(0,0,0,0.06); padding: 35px; border: 1px solid #eaeaea;">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @style = "color: #d9534f; font-size: 13px; margin-bottom: 20px; background: #ffeeee; padding: 10px; border-radius: 8px;" })

            <!-- Campo Frecuencia -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; color: #333; font-size: 13px; margin-bottom: 6px;">Frecuencia Asociada</label>
                @Html.DropDownList("FrecuenciaId", null, htmlAttributes: new { @class = "form-control", @style = "width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #fafafa;" })
                @Html.ValidationMessageFor(model => model.FrecuenciaId, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Campo Fecha de Operación -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; color: #333; font-size: 13px; margin-bottom: 6px;">Fecha de Operación</label>
                @Html.EditorFor(model => model.FechaOperacion, new { htmlAttributes = new { @class = "form-control", @placeholder = "YYYY-MM-DD", @style = "width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #fafafa;" } })
                @Html.ValidationMessageFor(model => model.FechaOperacion, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Campo Aeronave -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; color: #333; font-size: 13px; margin-bottom: 6px;">Aeronave Asignada</label>
                @Html.DropDownList("AeronaveId", null, htmlAttributes: new { @class = "form-control", @style = "width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #fafafa;" })
                @Html.ValidationMessageFor(model => model.AeronaveId, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Campo Estado del Vuelo -->
            <div style="margin-bottom: 30px;">
                <label style="display: block; font-weight: 600; color: #333; font-size: 13px; margin-bottom: 6px;">Estado del Vuelo</label>
                @Html.DropDownList("EstadoVueloCodigo", null, htmlAttributes: new { @class = "form-control", @style = "width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #fafafa;" })
                @Html.ValidationMessageFor(model => model.EstadoVueloCodigo, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Botón de Guardar -->
            <button type="submit" style="width: 100%; background: var(--vip-red); color: #fff; padding: 12px; border: none; border-radius: 50px; font-weight: 600; font-size: 15px; cursor: pointer; transition: background 0.2s;">
                Crear Registro
            </button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}