@model AerolineaVIP_MVC.Models.ComprobanteFilaViewModel
@{ ViewBag.Title = "Comprobante académico"; }
<section class="card p-4 mx-auto" style="max-width:750px">
  <h2>Comprobante académico</h2><p class="text-muted">Sin validez tributaria. No se realizó cobro real.</p>
  <dl class="row"><dt class="col-sm-5">Número</dt><dd class="col-sm-7">@Model.Numero</dd>
    <dt class="col-sm-5">Reserva</dt><dd class="col-sm-7">@Model.CodigoReserva</dd>
    <dt class="col-sm-5">Fecha</dt><dd class="col-sm-7">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-5">Importe simulado</dt><dd class="col-sm-7">@Model.Importe.ToString("N2") @Model.Moneda</dd>
    <dt class="col-sm-5">Tipo</dt><dd class="col-sm-7">@Model.Tipo</dd>
    <dt class="col-sm-5">Estado</dt><dd class="col-sm-7">@Model.Estado</dd></dl>
  <div class="d-print-none"><button type="button" class="btn btn-primary" onclick="window.print()">Imprimir / Guardar como PDF</button>
  <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Volver</a></div>
</section>
