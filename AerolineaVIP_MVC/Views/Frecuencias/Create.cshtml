@model AerolineaVIP_MVC.Models.Frecuencia

@{
    ViewBag.Title = "Crear Frecuencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 600px; margin: 40px auto; padding: 0 20px;">

    <!-- Encabezado y botón de retorno -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <div>
            <h2 style="font-weight: 800; color: var(--vip-ink); font-size: 26px; margin-bottom: 5px;">Registrar Nueva Frecuencia</h2>
            <p style="color: var(--vip-mute); font-size: 14px; margin: 0;">Configure los horarios y días operativos para las rutas de la aerolínea.</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" style="background: var(--vip-bg2); color: var(--vip-ink); padding: 8px 18px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 13px;">← Volver</a>
        </div>
    </div>

    <!-- Tarjeta contenedora del formulario -->
    <div style="background: var(--vip-card); border-radius: 16px; box-shadow: 0 4px 25px rgba(0,0,0,0.06); padding: 35px; border: 1px solid #eaeaea;">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @style = "color: #d9534f; font-size: 13px; margin-bottom: 20px; background: #ffeeee; padding: 10px; border-radius: 8px;" })

            <!-- Campo Ruta -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; color: #333; font-size: 13px; margin-bottom: 6px;">Ruta Asociada</label>
                @Html.DropDownList("RutaId", null, htmlAttributes: new { @class = "form-control", @style = "width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #fafafa;" })
                @Html.ValidationMessageFor(model => model.RutaId, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Campo Día de la Semana -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; color: #333; font-size: 13px; margin-bottom: 6px;">Día de la Semana</label>
                @Html.EditorFor(model => model.DiaSemana, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ej. Lunes o 1", @style = "width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #fafafa;" } })
                @Html.ValidationMessageFor(model => model.DiaSemana, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Campo Hora de Salida -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; color: #333; font-size: 13px; margin-bottom: 6px;">Hora de Salida</label>
                @Html.EditorFor(model => model.HoraSalida, new { htmlAttributes = new { @class = "form-control", @placeholder = "08:00", @style = "width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #fafafa;" } })
                @Html.ValidationMessageFor(model => model.HoraSalida, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Campo Hora de Llegada -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; color: #333; font-size: 13px; margin-bottom: 6px;">Hora de Llegada</label>
                @Html.EditorFor(model => model.HoraLlegada, new { htmlAttributes = new { @class = "form-control", @placeholder = "09:30", @style = "width: 100%; padding: 12px 16px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #fafafa;" } })
                @Html.ValidationMessageFor(model => model.HoraLlegada, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Campo Activa (Checkbox) -->
            <div style="margin-bottom: 30px; display: flex; align-items: center; gap: 10px;">
                @Html.EditorFor(model => model.Activa, new { htmlAttributes = new { @style = "width: 18px; height: 18px; accent-color: var(--vip-ink); cursor: pointer;" } })
                <label style="font-weight: 600; color: #333; font-size: 13px; cursor: pointer; margin: 0;">Frecuencia Activa</label>
                @Html.ValidationMessageFor(model => model.Activa, "", new { @style = "color: #d9534f; font-size: 12px;" })
            </div>

            <!-- Botón de Guardar -->
            <button type="submit" style="width: 100%; background: var(--vip-red); color: #fff; padding: 12px; border: none; border-radius: 50px; font-weight: 600; font-size: 15px; cursor: pointer; transition: background 0.2s;">
                Crear Registro
            </button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}