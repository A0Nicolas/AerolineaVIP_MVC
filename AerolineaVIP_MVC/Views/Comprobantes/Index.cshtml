@model IEnumerable<AerolineaVIP_MVC.Models.ComprobanteFilaViewModel>
@{ ViewBag.Title = "Mis comprobantes"; }
<h2>Mis comprobantes académicos</h2><p>Documentos de demostración sin validez tributaria.</p>
<div class="table-responsive"><table class="table table-striped"><thead>
<tr><th>Número</th><th>Reserva</th><th>Fecha</th><th>Importe</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var c in Model) { <tr><td>@c.Numero</td><td>@c.CodigoReserva</td><td>@c.Fecha.ToString("dd/MM/yyyy")</td>
<td>@c.Importe.ToString("N2") @c.Moneda</td><td>@c.Estado</td><td><a href="@Url.Action("Detalle", new { id = c.ComprobanteId })">Ver / imprimir</a></td></tr> }
</tbody></table></div>
@if (!Model.Any()) { <p>Todavía no tienes comprobantes.</p> }
