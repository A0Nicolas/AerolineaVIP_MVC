@model AerolineaVIP_MVC.Models.Frecuencia

@{
    ViewBag.Title = "Eliminar Frecuencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 600px; margin: 40px auto; padding: 0 20px;">

    <!-- Encabezado y botón de retorno -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <div>
            <h2 style="font-weight: 800; color: #d9534f; font-size: 26px; margin-bottom: 5px;">Eliminar Frecuencia</h2>
            <p style="color: var(--vip-mute); font-size: 14px; margin: 0;">¿Está seguro de que desea eliminar este horario de la programación?</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" style="background: var(--vip-bg2); color: var(--vip-ink); padding: 8px 18px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 13px;">← Volver al listado</a>
        </div>
    </div>

    <!-- Tarjeta contenedora de la información de eliminación -->
    <div style="background: var(--vip-card); border-radius: 16px; box-shadow: 0 4px 25px rgba(0,0,0,0.06); padding: 35px; border: 1px solid #eaeaea;">

        <div style="background: #fff5f5; border: 1px solid #fed7d7; padding: 15px; border-radius: 10px; margin-bottom: 25px;">
            <p style="color: #c53030; font-size: 13px; margin: 0; font-weight: 500;">
                ⚠️ Advertencia: Esta acción eliminará permanentemente la frecuencia seleccionada del sistema.
            </p>
        </div>

        <div style="margin-bottom: 25px;">
            <table style="width: 100%; font-size: 14px;">
                <tr style="border-bottom: 1px solid #f1f1f1;">
                    <td style="padding: 12px 0; font-weight: 600; color: #555;">@Html.DisplayNameFor(model => model.DiaSemana)</td>
                    <td style="padding: 12px 0; color: var(--vip-ink); font-weight: 700; text-align: right;">@Html.DisplayFor(model => model.DiaSemana)</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f1f1;">
                    <td style="padding: 12px 0; font-weight: 600; color: #555;">@Html.DisplayNameFor(model => model.HoraSalida)</td>
                    <td style="padding: 12px 0; color: var(--vip-ink); text-align: right;">@Html.DisplayFor(model => model.HoraSalida)</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f1f1;">
                    <td style="padding: 12px 0; font-weight: 600; color: #555;">@Html.DisplayNameFor(model => model.HoraLlegada)</td>
                    <td style="padding: 12px 0; color: var(--vip-ink); text-align: right;">@Html.DisplayFor(model => model.HoraLlegada)</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f1f1;">
                    <td style="padding: 12px 0; font-weight: 600; color: #555;">@Html.DisplayNameFor(model => model.Activa)</td>
                    <td style="padding: 12px 0; text-align: right;">@Html.DisplayFor(model => model.Activa)</td>
                </tr>
                <tr>
                    <td style="padding: 12px 0; font-weight: 600; color: #555;">@Html.DisplayNameFor(model => model.Ruta.RutaId)</td>
                    <td style="padding: 12px 0; color: var(--vip-ink); text-align: right;">@Html.DisplayFor(model => model.Ruta.RutaId)</td>
                </tr>
            </table>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div style="display: flex; gap: 15px;">
                <button type="submit" style="flex: 1; background: #d9534f; color: #fff; padding: 12px; border: none; border-radius: 50px; font-weight: 600; font-size: 15px; cursor: pointer; transition: background 0.2s;">
                    Sí, Eliminar
                </button>
                <a href="@Url.Action("Index")" style="flex: 1; text-align: center; background: var(--vip-bg2); color: var(--vip-ink); padding: 12px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 15px;">
                    Cancelar
                </a>
            </div>
        }
    </div>
</div>