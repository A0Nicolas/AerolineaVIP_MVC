@model AerolineaVIP_MVC.Models.VueloBusquedaViewModel
@{
    ViewBag.Title = "Buscar vuelos";
}
<div class="container py-4">
    <h2>Vuelos disponibles</h2>
    <p class="text-muted">Consulta de vuelos de Aerolínea VIP. Las plazas se verifican nuevamente al reservar.</p>
    @if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }
    @using (Html.BeginForm("Index", "Vuelos", FormMethod.Get, new { @class = "row g-3 mb-4" }))
    {
        <div class="col-md-3">
            @Html.LabelFor(m => m.Fecha, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Fecha, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.OrigenId, new { @class = "form-label" })
            @Html.DropDownListFor(m => m.OrigenId, Model.Aeropuertos, "Todos", new { @class = "form-select" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.DestinoId, new { @class = "form-label" })
            @Html.DropDownListFor(m => m.DestinoId, Model.Aeropuertos, "Todos", new { @class = "form-select" })
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary w-100" type="submit">Buscar vuelos</button>
        </div>
    }
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead><tr><th>Vuelo</th><th>Fecha</th><th>Ruta</th><th>Horario</th><th>Tarifa referencial</th><th>Plazas</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model.Resultados)
            {
                <tr>
                    <td>VIP@(v.VueloId.ToString("D5"))</td>
                    <td>@v.FechaOperacion.ToString("dd/MM/yyyy")</td>
                    <td>@v.Origen → @v.Destino</td>
                    <td>@v.HoraSalida.ToString(@"hh\:mm") - @v.HoraLlegada.ToString(@"hh\:mm")</td>
                    <td>@v.Tarifa.ToString("N2")</td>
                    <td>@v.Disponibles / @v.Capacidad</td>
                    <td>@Html.ActionLink("Ver asientos", "Detalle", new { id = v.VueloId }, new { @class = "btn btn-outline-primary btn-sm" })</td>
                </tr>
            }
            @if (Model.Resultados.Count == 0)
            {
                <tr><td colspan="7" class="text-center">No se encontraron vuelos programados para esos filtros.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
